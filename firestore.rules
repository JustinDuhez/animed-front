rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: animals
// Document ID: animal ID string (e.g. "MAR-00043")
// Fields:
//   - id: string (required, matches document ID, immutable)
//   - emoji: string (required, 1–8 chars)
//   - name: string (required, 1–100 chars)
//   - species: string (required, 1–100 chars)
//   - status: string (required, enum: actif | repos | alerte | retraite)
//   - vaccineOk: boolean (required)
//   - sessions: number (required, >= 0)
//   - lastSession: string (required, <= 50 chars)
//   - handler: string (required, <= 100 chars)
//   - gender: string (required, Mâle | Femelle)
//   - birthDate: string (required, <= 20 chars)
//   - weight: string (required, <= 30 chars)
//   - chipId: string (required, <= 30 chars)
//   - lastVetCheck: string (required, <= 50 chars)
//   - antiparasiteOk: boolean (required)
//   - antiparasiteInfo: string (required, <= 200 chars)
//   - vermifugeDaysLeft: number | null (required)
//   - establishments: list of strings (required, <= 20 items, each <= 100 chars)
//   - nextSession: map | null (optional, { structure: string, date: string })
//   - vaccines: list of maps (required, <= 10 items, each { name, status, info })
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Helper Functions
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function validStr(field, minLen, maxLen) {
      return request.resource.data[field] is string
          && request.resource.data[field].size() >= minLen
          && request.resource.data[field].size() <= maxLen;
    }

    // ===============================================================
    // Animal Validator
    // ===============================================================

    function isValidAnimal() {
      let d = request.resource.data;
      let allowedFields = [
        'id', 'emoji', 'name', 'species', 'status', 'vaccineOk',
        'sessions', 'lastSession', 'handler', 'gender', 'birthDate',
        'weight', 'chipId', 'lastVetCheck', 'antiparasiteOk',
        'antiparasiteInfo', 'vermifugeDaysLeft', 'establishments',
        'nextSession', 'vaccines'
      ];
      return hasOnlyAllowedFields(allowedFields)
          && hasRequiredFields(allowedFields)
          && d.id is string && d.id.size() >= 1 && d.id.size() <= 30
          && d.emoji is string && d.emoji.size() >= 1 && d.emoji.size() <= 8
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
          && d.species is string && d.species.size() >= 1 && d.species.size() <= 100
          && d.status in ['actif', 'repos', 'alerte', 'retraite']
          && d.vaccineOk is bool
          && d.sessions is number && d.sessions >= 0
          && d.lastSession is string && d.lastSession.size() <= 50
          && d.handler is string && d.handler.size() <= 100
          && d.gender in ['Mâle', 'Femelle']
          && d.birthDate is string && d.birthDate.size() <= 20
          && d.weight is string && d.weight.size() <= 30
          && d.chipId is string && d.chipId.size() <= 30
          && d.lastVetCheck is string && d.lastVetCheck.size() <= 50
          && d.antiparasiteOk is bool
          && d.antiparasiteInfo is string && d.antiparasiteInfo.size() <= 200
          && (d.vermifugeDaysLeft == null || d.vermifugeDaysLeft is number)
          && d.establishments is list && d.establishments.size() <= 20
          && d.vaccines is list && d.vaccines.size() <= 10
          && (d.nextSession == null || d.nextSession is map);
    }

    // ===============================================================
    // Animals Collection
    // ===============================================================

    match /animals/{animalId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && isValidAnimal()
                    && request.resource.data.id == animalId;

      allow update: if isAuthenticated()
                    && isValidAnimal()
                    && request.resource.data.id == resource.data.id;

      allow delete: if isAuthenticated();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
