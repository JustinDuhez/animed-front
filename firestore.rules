rules_version = '2';

// Collection: animals — Document fields described in data/animals.ts
// Collection: sessions — Document fields described in data/animals.ts (Session interface)
// Collection: users — Document fields described in data/user.ts

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function roleOf() {
      let u = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(u) ? get(u).data.role : 'viewer';
    }

    function isAdmin()  { return roleOf() == 'admin'; }
    function isEditor() { return roleOf() in ['admin', 'editor']; }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    // ── Users collection ──────────────────────────────────────────

    match /users/{uid} {
      allow read:   if isAuthenticated() && (request.auth.uid == uid || isAdmin());
      allow create: if isAuthenticated()
                    && request.auth.uid == uid
                    && request.resource.data.role == 'viewer'
                    && hasOnlyAllowedFields(['email', 'displayName', 'role', 'createdAt']);
      allow update: if isAuthenticated() && (
                      isAdmin() ||
                      // Users can update their own profile but cannot change their role
                      (request.auth.uid == uid
                        && request.resource.data.role == resource.data.role
                        && hasOnlyAllowedFields(['email', 'displayName', 'role', 'createdAt']))
                    );
      allow delete: if false;
    }

    // ── Animal validator ──────────────────────────────────────────

    function isValidAnimal() {
      let d = request.resource.data;
      let allowedFields = [
        'id', 'emoji', 'name', 'species', 'status', 'vaccineOk',
        'sessions', 'lastSession', 'handler', 'gender', 'birthDate',
        'weight', 'chipId', 'lastVetCheck', 'antiparasiteOk',
        'antiparasiteInfo', 'vermifugeLastDate', 'establishments',
        'nextSession', 'vaccines', 'qrCode', 'penMaintenance'
      ];
      let requiredFields = [
        'id', 'emoji', 'name', 'species', 'status', 'vaccineOk',
        'sessions', 'lastSession', 'handler', 'gender', 'birthDate',
        'weight', 'chipId', 'lastVetCheck', 'antiparasiteOk',
        'antiparasiteInfo', 'vermifugeLastDate', 'establishments',
        'nextSession', 'vaccines'
      ];
      return hasOnlyAllowedFields(allowedFields)
          && hasRequiredFields(requiredFields)
          && d.id is string && d.id.size() >= 1 && d.id.size() <= 30
          && d.emoji is string && d.emoji.size() >= 1 && d.emoji.size() <= 8
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
          && d.species is string && d.species.size() >= 1 && d.species.size() <= 100
          && d.status in ['actif', 'repos', 'alerte', 'retraite']
          && d.vaccineOk is bool
          && d.sessions is map
          && d.lastSession is string && d.lastSession.size() <= 50
          && d.handler is string && d.handler.size() <= 100
          && d.gender in ['Mâle', 'Femelle']
          && d.birthDate is string && d.birthDate.size() <= 20
          && d.weight is string && d.weight.size() <= 30
          && d.chipId is string && d.chipId.size() <= 30
          && d.lastVetCheck is string && d.lastVetCheck.size() <= 50
          && d.antiparasiteOk is bool
          && d.antiparasiteInfo is string && d.antiparasiteInfo.size() <= 200
          && d.vermifugeLastDate is string && d.vermifugeLastDate.size() <= 20
          && d.establishments is list && d.establishments.size() <= 20
          && d.vaccines is list && d.vaccines.size() <= 10
          && (d.nextSession == null || d.nextSession is map)
          && (!d.keys().hasAny(['qrCode']) || d.qrCode is string)
          && (!d.keys().hasAny(['penMaintenance']) || d.penMaintenance is string);
    }

    // ── Session validator ─────────────────────────────────────────

    function isValidSession() {
      let d = request.resource.data;
      let allowedFields = ['id', 'animalIds', 'date', 'structure', 'handler', 'notes', 'status', 'startedAt', 'endedAt', 'survey'];
      let requiredFields = ['id', 'animalIds', 'date', 'structure', 'handler', 'notes', 'status']; 
      return hasOnlyAllowedFields(allowedFields)
          && hasRequiredFields(requiredFields)
          && d.id is string && d.id.size() >= 1 && d.id.size() <= 50
          && d.animalIds is list && d.animalIds.size() <= 20
          && d.date is string && d.date.size() <= 30
          && d.structure is string && d.structure.size() <= 100
          && d.handler is string && d.handler.size() <= 100
          && d.notes is string && d.notes.size() <= 1000
          && d.status in ['completed', 'planned', 'cancelled', 'inProgress']
          && (!d.keys().hasAny(['startedAt']) || d.startedAt is timestamp)                                                                                                                                                                                                                                                 
          && (!d.keys().hasAny(['endedAt']) || d.endedAt is timestamp)                                                                                                                                                                                                                                                     
          && (!d.keys().hasAny(['survey']) || d.survey is map);
    }

    // ── Organization validator ────────────────────────────────────

    function isValidOrganization() {
      let d = request.resource.data;
      let allowedFields = ['id', 'name', 'type', 'address', 'phone', 'email', 'contact', 'notes', 'status'];
      return hasOnlyAllowedFields(allowedFields)
          && hasRequiredFields(allowedFields)
          && d.id is string && d.id.size() >= 1 && d.id.size() <= 60
          && d.name is string && d.name.size() >= 1 && d.name.size() <= 100
          && d.type in ['ehpad', 'ets', 'scolaire', 'petiteEnfance', 'individuel']
          && d.address is string && d.address.size() <= 200
          && d.phone is string && d.phone.size() <= 30
          && d.email is string && d.email.size() <= 100
          && d.contact is string && d.contact.size() <= 100
          && d.notes is string && d.notes.size() <= 1000
          && d.status in ['active', 'inactive'];
    }

    // ── Animals collection ────────────────────────────────────────

    match /animals/{animalId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && isEditor()
                    && isValidAnimal()
                    && request.resource.data.id == animalId;

      allow update: if isAuthenticated()
                    && isEditor()
                    && request.resource.data.id == resource.data.id;

      allow delete: if isAuthenticated() && isAdmin();

      match /documents/{docId} {
        allow read:   if isAuthenticated();
        allow create: if isAuthenticated() && isEditor() && request.resource.data.id == docId;
        allow delete: if isAuthenticated() && isEditor();
      }
    }

    // ── Sessions collection ───────────────────────────────────────

    match /sessions/{sessionId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && isEditor()
                    && isValidSession()
                    && request.resource.data.id == sessionId;

      allow update: if isAuthenticated()
                    && isEditor()
                    && isValidSession()
                    && request.resource.data.id == resource.data.id;

      allow delete: if isAuthenticated() && isEditor();
    }

    // ── Organizations collection ──────────────────────────────────

    match /organizations/{orgId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && isEditor()
                    && isValidOrganization()
                    && request.resource.data.id == orgId;

      allow update: if isAuthenticated()
                    && isEditor()
                    && isValidOrganization()
                    && request.resource.data.id == resource.data.id;

      allow delete: if isAuthenticated() && isAdmin();
    }

    // ── Staff validator ──────────────────────────────────────────

    function isValidStaff() {
      let d = request.resource.data;
      let allowedFields = ['id', 'firstName', 'lastName', 'email', 'phone', 'type', 'status', 'acacedCertified', 'notes'];
      return hasOnlyAllowedFields(allowedFields)
          && hasRequiredFields(allowedFields)
          && d.id is string && d.id.size() >= 1 && d.id.size() <= 50
          && d.firstName is string && d.firstName.size() <= 100
          && d.lastName is string && d.lastName.size() <= 100
          && d.email is string && d.email.size() <= 100
          && d.phone is string && d.phone.size() <= 30
          && d.type in ['educateur', 'psychologue', 'infirmier', 'kinesitherapeute', 'veterinaire', 'benevole', 'autre']
          && d.status in ['active', 'inactive']
          && d.acacedCertified is bool
          && d.notes is string && d.notes.size() <= 1000;
    }

    // ── Staff collection ──────────────────────────────────────────

    match /staff/{staffId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
                    && isEditor()
                    && isValidStaff()
                    && request.resource.data.id == staffId;

      allow update: if isAuthenticated()
                    && isEditor()
                    && isValidStaff()
                    && request.resource.data.id == resource.data.id;

      allow delete: if isAuthenticated() && isAdmin();
    }

    // Deny everything else
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
